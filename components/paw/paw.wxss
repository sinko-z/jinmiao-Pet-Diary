.paw { position: relative; display: inline-block; }
.paw-ball {
  position: absolute; left: 20%; top: 42%;
  width: 60%; height: 50%;
  border-radius: 50% 50% 46% 46% / 62% 62% 38% 38%;
}
.paw-toe { position: absolute; width: 26%; height: 26%; border-radius: 50%; }
.t1 { left: 2%;  top: 12%; }
.t2 { left: 37%; top: 0; }
.t3 { left: 72%; top: 12%; }
.t4 { left: 37%; top: 36%; }

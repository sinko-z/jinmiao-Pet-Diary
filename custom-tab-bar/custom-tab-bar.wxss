/* custom-tab-bar/index.wxss */
.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 249, 240, 0.98);
  backdrop-filter: blur(20rpx);
  display: flex;
  border-top: 1rpx solid #FFE7CD;
  box-shadow: 0 -6rpx 30rpx rgba(180, 110, 40, 0.08);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B08968;
}
.tab-icon { font-size: 44rpx; line-height: 1.1; filter: grayscale(.55); opacity: .85; transition: all .2s; }
.tab-text { font-size: 20rpx; margin-top: 4rpx; }
.tab-item.active .tab-icon { filter: none; opacity: 1; transform: translateY(-2rpx); }
.tab-item.active .tab-text { color: #E8590C; font-weight: 700; }

/* pages/shop/index/index.wxss */
.shop-hero {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, #FCE3B1, #F7C170);
  padding: 34rpx 30rpx 26rpx;
  border-radius: 0 0 48rpx 48rpx;
}
.sh-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.18); }
.o1 { width: 280rpx; height: 280rpx; top: -120rpx; right: -60rpx; }
.o2 { width: 180rpx; height: 180rpx; bottom: -80rpx; left: 20rpx; background: rgba(255,255,255,.12); }
.sh-top { display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1; }
.sh-title { font-size: 40rpx; font-weight: 800; color: #6B4514; }
.sh-sub { font-size: 23rpx; color: #8C5A2B; margin-top: 4rpx; }
.sh-locate {
  font-size: 22rpx; color: #6B4514; background: rgba(255,255,255,.75);
  padding: 8rpx 22rpx; border-radius: 30rpx;
}
.sh-cats { display: flex; margin-top: 22rpx; gap: 14rpx; position: relative; z-index: 1; }
.sh-cat {
  padding: 10rpx 26rpx; border-radius: 30rpx; font-size: 24rpx;
  background: rgba(255,255,255,.7); color: #7A5A2E;
}
.sh-cat.active { background: #D96A1E; color: #fff; font-weight: 700; }
.sh-sort-row {
  display: flex; align-items: center; margin-top: 18rpx; position: relative; z-index: 1;
}
.sh-sort { font-size: 23rpx; color: #7A5A2E; margin-right: 22rpx; background: rgba(255,255,255,.6); padding: 6rpx 18rpx; border-radius: 26rpx; }
.sh-sort.on { color: #6B4514; font-weight: 800; background: rgba(255,255,255,.9); }
.sh-cert { margin-left: auto; font-size: 21rpx; color: #6C8F46; font-weight: 700; }

.container { padding-top: 26rpx; }

.my-shop {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FFF1DC, #FFE4C0);
  border: 1rpx solid #FFD9A0; border-radius: 26rpx;
  padding: 22rpx; margin-bottom: 20rpx;
}
.ms-logo {
  width: 84rpx; height: 84rpx; border-radius: 24rpx;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; margin-right: 20rpx;
}
.ms-name { font-size: 29rpx; font-weight: 800; color: #6E4224; }
.ms-desc { font-size: 22rpx; color: #A5794E; margin-top: 4rpx; }
.ms-arrow { font-size: 40rpx; color: #C97B3C; }

.join-banner {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FF9F4A, #F47521);
  border-radius: 28rpx; padding: 26rpx 24rpx; margin-bottom: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(244,117,33,.3);
}
.jb-paw { margin-right: 20rpx; }
.jb-title { font-size: 29rpx; font-weight: 800; color: #fff; }
.jb-desc { font-size: 21rpx; color: rgba(255,255,255,.9); margin-top: 4rpx; }
.jb-btn {
  font-size: 24rpx; color: #D96A1E; background: #fff;
  padding: 12rpx 24rpx; border-radius: 32rpx; font-weight: 800; flex-shrink: 0;
}

.shop-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 28rpx; padding: 24rpx;
  margin-bottom: 22rpx; box-shadow: 0 8rpx 24rpx rgba(180,110,40,.09);
  border: 1rpx solid rgba(255,214,170,.4);
}
.sc-logo {
  width: 108rpx; height: 108rpx; border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx; flex-shrink: 0; margin-right: 22rpx;
}
.sc-name-row { display: flex; align-items: center; }
.sc-name { font-size: 31rpx; font-weight: 800; color: #52311B; margin-right: 10rpx; }
.sc-badge {
  font-size: 18rpx; color: #6C8F46; background: #EAF2DF;
  padding: 2rpx 12rpx; border-radius: 16rpx; font-weight: 700;
}
.sc-meta { display: flex; align-items: center; margin-top: 6rpx; }
.sc-dist { font-size: 23rpx; color: #D96A1E; font-weight: 700; margin-right: 20rpx; }
.sc-hour { font-size: 22rpx; color: #8C5A2B; }
.sc-rating { display: flex; align-items: center; margin-top: 8rpx; }
.stars { color: #F2B04C; font-size: 24rpx; letter-spacing: 2rpx; }
.stars .half { opacity: .55; }
.stars .gray { color: #E9DFD2; }
.sc-score { font-size: 25rpx; font-weight: 800; color: #B47D24; margin-left: 10rpx; }
.sc-count { font-size: 21rpx; color: #C9A381; margin-left: 12rpx; }
.sc-tags { margin-top: 10rpx; }
.sc-arrow { font-size: 40rpx; color: #E4CDB4; margin-left: 10rpx; }

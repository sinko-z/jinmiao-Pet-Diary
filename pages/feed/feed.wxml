<!--pages/feed/feed.wxml-->
<view class="page">
  <view class="feed-hero">
    <view class="fh-emoji">🍚</view>
    <view class="fh-info">
      <view class="fh-title">{{petName}} 的今日投喂</view>
      <view class="fh-sub">{{today}} · 记得按时干饭</view>
    </view>
  </view>

  <view class="container">
    <!-- 投喂计划 -->
    <view class="section-head">
      <view class="section-title">投喂计划</view>
      <view class="link-more" bindtap="requestNotify">🔔 提醒设置</view>
    </view>

    <view class="plan-list">
      <view class="plan-item" wx:for="{{plans}}" wx:key="id">
        <view class="plan-time-box">
          <view class="plan-time">{{item.time}}</view>
          <view class="plan-ampm">{{item.time < '12:00' ? '上午' : item.time < '18:00' ? '下午' : '晚上'}}</view>
        </view>
        <view class="plan-mid flex1">
          <view class="plan-content">{{item.content}}</view>
          <view class="plan-meta">
            <switch checked="{{item.notify}}" color="#F47521" style="transform:scale(.8)" data-id="{{item.id}}" bindchange="togglePlanNotify" />
            <text class="plan-del" data-id="{{item.id}}" bindtap="delPlan">删除</text>
          </view>
        </view>
        <view class="plan-side">
          <view wx:if="{{item.doneToday}}" class="done-badge">✓ 已投喂</view>
          <block wx:else>
            <view class="btn btn-primary btn-sm" data-id="{{item.id}}" bindtap="markDone">标记已喂</view>
            <view class="miss-btn" data-id="{{item.id}}" bindtap="markMiss">未投喂</view>
          </block>
        </view>
      </view>

      <view class="empty" wx:if="{{!plans.length}}">
        <view class="empty-icon">⏰</view>
        <view class="empty-title">还没有投喂计划</view>
        <view class="empty-desc">设置每日定时投喂，到点自动提醒</view>
      </view>
    </view>

    <view class="add-plan" bindtap="openAdd">＋ 添加投喂时段</view>

    <!-- 投喂记录 -->
    <view class="section-head">
      <view class="section-title">投喂记录</view>
      <view class="count-desc">共 {{records.length}} 条</view>
    </view>
    <view class="card">
      <view class="rec-row" wx:for="{{records}}" wx:key="id">
        <view class="rec-check">✓</view>
        <view class="rec-body flex1">
          <view class="rec-line"><text class="rec-content">{{item.content}}</text><text class="rec-user">{{item.user}}</text></view>
          <view class="rec-time">{{item.date}} {{item.time}} 投喂</view>
        </view>
      </view>
      <view class="empty" wx:if="{{!records.length}}" style="padding:60rpx 20rpx">
        <view class="empty-title" style="margin-bottom:0">暂无记录</view>
      </view>
    </view>
  </view>

  <!-- 添加计划弹层 -->
  <view class="mask" wx:if="{{showAddPlan}}" bindtap="closeAdd">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">添加投喂时段</view>
      <view class="form-card" style="margin:0">
        <view class="form-item">
          <view class="form-label">投喂时间</view>
          <picker mode="time" value="{{planForm.time}}" bindchange="onPlanTime">
            <view class="form-value picker-value">{{planForm.time}}<text class="form-arrow">▾</text></view>
          </picker>
        </view>
        <view class="form-item">
          <view class="form-label">内容 / 份量</view>
          <input class="form-input" placeholder="如：猫粮 30g" placeholder-class="ph"
            value="{{planForm.content}}" bindinput="onPlanContent" />
        </view>
        <view class="form-item">
          <view class="form-label">到点推送提醒</view>
          <switch checked="{{planForm.notify}}" color="#F47521" bindchange="onPlanNotify" />
        </view>
      </view>
      <view class="sheet-actions">
        <button class="btn btn-ghost flex1" bindtap="closeAdd">取消</button>
        <button class="btn btn-primary flex1" style="margin-left:20rpx" bindtap="savePlan">保存计划</button>
      </view>
    </view>
  </view>
</view>

/* pages/profile/edit/edit.wxss */
.pe-hero {
  display: flex; flex-direction: column; align-items: center;
  background: linear-gradient(160deg, #FFD9A0, #FF9F4A);
  padding: 60rpx 0 56rpx;
  border-radius: 0 0 48rpx 48rpx;
}
.pe-avatar { border: 6rpx solid rgba(255,255,255,.7); box-shadow: 0 10rpx 26rpx rgba(120,60,10,.2); }
.pe-title { font-size: 34rpx; font-weight: 800; color: #5E3716; margin-top: 18rpx; }
.pe-sub { font-size: 23rpx; color: #7A4A1E; margin-top: 4rpx; }

.container { padding-top: 30rpx; }
.color-label { font-size: 27rpx; font-weight: 700; color: #6E4224; }
.color-row { display: flex; margin-top: 18rpx; flex-wrap: wrap; }
.color-dot {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  margin: 0 22rpx 18rpx 0; border: 5rpx solid transparent;
}
.color-dot.on { border-color: #52311B; transform: scale(1.1); }
.ph { color: #C9A381; }
.pe-openid { text-align: center; font-size: 20rpx; color: #C9A381; margin: 10rpx 0 22rpx; word-break: break-all; }

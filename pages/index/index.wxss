/* pages/index/index.wxss —— 首页暖色样式 */
.hero {
  position: relative;
  padding: 24rpx 30rpx 36rpx;
  background: linear-gradient(160deg, #FFD9A0 0%, #FFB36B 55%, #FF9F4A 100%);
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}
.hero-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.18); }
.orb1 { width: 260rpx; height: 260rpx; top: -90rpx; right: -60rpx; }
.orb2 { width: 160rpx; height: 160rpx; bottom: -60rpx; left: 40rpx; background: rgba(255,255,255,.12); }
.hero-top { display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1; }
.hero-greet { font-size: 26rpx; color: rgba(94, 55, 22, .8); font-weight: 600; }
.hero-title { font-size: 42rpx; font-weight: 800; color: #5E3716; margin-top: 6rpx; }
.hero-user { width: 84rpx; height: 84rpx; font-size: 32rpx; box-shadow: 0 6rpx 16rpx rgba(0,0,0,.12); }

.search-bar {
  position: relative; z-index: 2;
  margin-top: 26rpx;
  display: flex; align-items: center;
  height: 76rpx; padding: 0 26rpx;
  background: rgba(255, 253, 249, .96);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 20rpx rgba(150, 80, 20, .16);
}
.search-icon { font-size: 26rpx; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 26rpx; color: #6E4224; height: 76rpx; line-height: 76rpx; }
.search-ph { color: #B08968; font-size: 26rpx; flex: 1; }
.search-clear { width: 40rpx; height: 40rpx; background: #FFE4CC; color: #C97B3C; border-radius: 50%; text-align: center; line-height: 40rpx; font-size: 22rpx; }

.quick-row { display: flex; justify-content: space-between; position: relative; z-index: 2; margin-top: 30rpx; }
.quick-item { display: flex; flex-direction: column; align-items: center; width: 25%; }
.quick-icon {
  width: 88rpx; height: 88rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-bottom: 10rpx;
  box-shadow: 0 6rpx 14rpx rgba(150,80,20,.14);
  border: 1rpx solid rgba(255,255,255,.6);
}
.quick-item text { font-size: 22rpx; color: #6E4224; font-weight: 600; }

.container { padding-top: 30rpx; }
.count-desc { font-size: 24rpx; color: #B08968; }
.filter-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.filter-chip {
  padding: 10rpx 30rpx; border-radius: 32rpx; font-size: 26rpx;
  background: #FFFFFF; color: #8C5A2B;
  border: 1rpx solid #FFE2C2; transition: all .2s;
}
.filter-chip.active {
  background: linear-gradient(135deg, #FF9F4A, #F47521);
  color: #fff; border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(244,117,33,.25);
}

.pet-card {
  display: flex; align-items: center;
  background: #fff; border-radius: 30rpx; padding: 22rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 26rpx rgba(180,110,40,.1);
  border: 1rpx solid rgba(255,214,170,.4);
  position: relative;
}
.pet-cover {
  width: 160rpx; height: 160rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative; flex-shrink: 0;
}
.pet-emoji { font-size: 84rpx; }
.pet-type { position: absolute; left: 8rpx; bottom: 8rpx; font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 16rpx; color: #fff; }
.pet-info { flex: 1; min-width: 0; margin-left: 24rpx; }
.pet-name-row { display: flex; align-items: center; }
.pet-name { font-size: 34rpx; font-weight: 800; color: #52311B; margin-right: 6rpx; }
.pet-gender { font-size: 28rpx; color: #E8590C; margin-right: 8rpx; }
.pet-meta { font-size: 24rpx; color: #8C5A2B; margin: 6rpx 0; }
.pet-tags { margin: 4rpx 0 10rpx; }
.pet-members { display: flex; align-items: center; }
.mini-avatar { border: 2rpx solid #fff; }
.member-more { font-size: 20rpx; color: #B08968; margin-left: 16rpx; }
.card-arrow { font-size: 40rpx; color: #E4CDB4; margin-left: 8rpx; }

.add-card {
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #FFB36B; border-radius: 30rpx;
  padding: 32rpx; background: rgba(255, 244, 230, .6);
}
.add-plus {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: linear-gradient(135deg,#FF9F4A,#F47521); color: #fff;
  font-size: 40rpx; display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
}
.add-title { font-size: 28rpx; font-weight: 700; color: #6E4224; }
.add-desc { font-size: 23rpx; color: #B08968; }

.bottom-tip { text-align: center; font-size: 22rpx; color: #C9A381; padding: 30rpx 0 10rpx; }
/* v1.1：hero 爪印装饰 */
.hero-paw { position: absolute; right: 160rpx; bottom: -30rpx; opacity: .9; }

/* pages/login/login.wxss */
.login-page { min-height: 100vh; background: linear-gradient(180deg, #FFE7C8 0%, #FFF7EE 60%); }
.lg-hero {
  position: relative; overflow: hidden;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 0 90rpx;
  background: linear-gradient(160deg, #FFD9A0, #FF9F4A);
  border-radius: 0 0 60rpx 60rpx;
}
.lg-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.16); }
.o1 { width: 320rpx; height: 320rpx; top: -120rpx; right: -100rpx; }
.o2 { width: 220rpx; height: 220rpx; bottom: -100rpx; left: -60rpx; }
.lg-name { font-size: 52rpx; font-weight: 800; color: #5E3716; margin-top: 8rpx; }
.lg-slogan { font-size: 25rpx; color: #7A4A1E; margin-top: 10rpx; letter-spacing: 2rpx; }

.container { padding: 44rpx 40rpx; }
.lg-card { padding: 40rpx 36rpx; }
.lg-title { font-size: 28rpx; font-weight: 700; color: #6E4224; }
.lg-avatar-row { display: flex; align-items: center; margin-top: 20rpx; }
.lg-avatar { width: 120rpx; height: 120rpx; font-size: 52rpx; }
.color-list { display: flex; flex-wrap: wrap; margin-left: 30rpx; flex: 1; }
.color-dot {
  width: 52rpx; height: 52rpx; border-radius: 50%;
  margin: 0 16rpx 16rpx 0; border: 4rpx solid transparent;
}
.color-dot.on { border-color: #52311B; transform: scale(1.12); }
.lg-tips { margin: 24rpx 0 8rpx; }
.tip-line { font-size: 24rpx; color: #8C5A2B; margin: 8rpx 0; }
.agree-row { display: flex; align-items: center; margin: 26rpx 0 30rpx; }
.agree-box {
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  border: 2rpx solid #FFB36B; margin-right: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
}
.agree-box.on { background: #F47521; border-color: #F47521; }
.agree-text { font-size: 24rpx; color: #8C5A2B; }
.agree-link { color: #F47521; }
.lg-foot { text-align: center; font-size: 20rpx; color: #C9A381; margin-top: 24rpx; }

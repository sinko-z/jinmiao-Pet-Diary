/* pages/pet/nearby/nearby.wxss */
.pn-hero {
  position: relative; overflow: hidden;
  background: linear-gradient(160deg, #DCEBC6, #9FBE75);
  padding: 32rpx 30rpx 24rpx;
  border-radius: 0 0 48rpx 48rpx;
}
.pn-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.18); }
.o1 { width: 280rpx; height: 280rpx; top: -120rpx; right: -60rpx; }
.o2 { width: 170rpx; height: 170rpx; bottom: -80rpx; left: -30rpx; background: rgba(255,255,255,.12); }
.pn-top { display: flex; justify-content: space-between; align-items: flex-start; position: relative; z-index: 1; }
.pn-title { font-size: 40rpx; font-weight: 800; color: #3F5A22; }
.pn-sub { font-size: 23rpx; color: #5F7A42; margin-top: 4rpx; }
.pn-locate {
  font-size: 22rpx; color: #3F5A22; background: rgba(255,255,255,.75);
  padding: 8rpx 22rpx; border-radius: 30rpx;
}
.pn-filter { display: flex; margin-top: 20rpx; gap: 14rpx; position: relative; z-index: 1; }
.pn-chip {
  padding: 10rpx 26rpx; border-radius: 30rpx; font-size: 24rpx;
  background: rgba(255,255,255,.7); color: #5F7A42;
}
.pn-chip.active { background: #7BA05B; color: #fff; font-weight: 700; }
.pn-seg { display: flex; margin-top: 20rpx; background: rgba(255,255,255,.55); border-radius: 40rpx; padding: 5rpx; width: 300rpx; position: relative; z-index: 1; }
.pn-seg-item { flex: 1; text-align: center; padding: 10rpx 0; font-size: 24rpx; color: #5F7A42; border-radius: 34rpx; }
.pn-seg-item.active { background: #fff; color: #3F5A22; font-weight: 800; }

.container { padding-top: 26rpx; }
.np-card {
  display: flex; align-items: flex-start;
  background: #fff; border-radius: 28rpx; padding: 24rpx;
  margin-bottom: 22rpx; box-shadow: 0 8rpx 24rpx rgba(80,120,40,.08);
}
.np-avatar {
  width: 110rpx; height: 110rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 58rpx; flex-shrink: 0; margin-right: 20rpx;
}
.np-name-row { display: flex; align-items: center; }
.np-name { font-size: 31rpx; font-weight: 800; color: #52311B; margin-right: 10rpx; }
.np-meta { font-size: 22rpx; color: #8C5A2B; margin-top: 4rpx; }
.np-loc { font-size: 22rpx; color: #D96A1E; font-weight: 600; margin-top: 2rpx; }
.np-intro {
  font-size: 24rpx; color: #6E4224; line-height: 1.6; margin-top: 8rpx;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
.np-tags { margin-top: 8rpx; }
.np-actions { display: flex; flex-direction: column; gap: 14rpx; flex-shrink: 0; margin-left: 12rpx; }
.np-btn {
  width: 92rpx; text-align: center;
  font-size: 22rpx; color: #6C8F46; border: 2rpx solid #BFD3A2;
  border-radius: 30rpx; padding: 10rpx 0;
}
.np-btn.friend { background: linear-gradient(135deg, #8FBF6E, #6C8F46); color: #fff; border-color: transparent; }

.pn-map-wrap { }
.pn-map { width: 100%; height: 820rpx; border-radius: 30rpx; }
.pn-legend { font-size: 23rpx; color: #6C8F46; margin-top: 16rpx; text-align: center; }
.pn-tip {
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #B08968; margin-top: 10rpx;
}
.pn-tip paw { margin-right: 10rpx; }
/* 定位隐私说明条 */
.loc-privacy {
  display: flex; align-items: center;
  margin: 0 24rpx; padding: 18rpx 22rpx;
  background: rgba(255,255,255,.85); border-radius: 20rpx;
  border: 1rpx solid #E3EDD2;
}
.lp-icon { font-size: 34rpx; margin-right: 14rpx; }
.lp-text { font-size: 21rpx; color: #6C8F46; line-height: 1.6; }
.lp-link { color: #D96A1E; text-decoration: underline; }
.lp-state {
  flex-shrink: 0; font-size: 20rpx; color: #B08968;
  background: #F3EDE3; border-radius: 24rpx; padding: 6rpx 16rpx;
}
.lp-state.on { color: #6C8F46; background: #EAF2DF; }

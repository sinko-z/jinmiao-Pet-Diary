/* pages/pet/detail/detail.wxss */
.pet-head {
  position: relative;
  padding: 30rpx 30rpx 0;
  border-radius: 0 0 52rpx 52rpx;
  overflow: hidden;
}
.head-orb { position: absolute; border-radius: 50%; background: rgba(255,255,255,.2); }
.r1 { width: 280rpx; height: 280rpx; top: -120rpx; right: -80rpx; }
.r2 { width: 200rpx; height: 200rpx; bottom: -90rpx; left: -50rpx; }
.head-main { display: flex; align-items: center; position: relative; z-index: 1; }
.head-avatar {
  width: 150rpx; height: 150rpx; border-radius: 36rpx;
  background: rgba(255,255,255,.92);
  display: flex; align-items: center; justify-content: center;
  font-size: 90rpx; box-shadow: 0 10rpx 24rpx rgba(120,60,10,.18);
  flex-shrink: 0;
}
.head-info { flex: 1; min-width: 0; margin-left: 24rpx; }
.head-name-row { display: flex; align-items: center; }
.head-name { font-size: 44rpx; font-weight: 800; color: #52311B; margin-right: 6rpx; }
.head-gender { font-size: 32rpx; color: #E8590C; margin-right: 10rpx; }
.head-meta { font-size: 24rpx; color: #6E4224; margin-top: 6rpx; }
.head-tags { margin-top: 10rpx; }
.head-edit {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: rgba(255,255,255,.8); color: #C97B3C;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; margin-left: 12rpx; flex-shrink: 0;
}
.head-stats {
  position: relative; z-index: 1;
  display: flex; align-items: center; justify-content: space-around;
  margin-top: 30rpx;
  background: rgba(255,255,255,.55);
  border-radius: 26rpx 26rpx 0 0;
  padding: 22rpx 10rpx;
  backdrop-filter: blur(10rpx);
}
.stat { display: flex; flex-direction: column; align-items: center; width: 30%; }
.stat-num { font-size: 38rpx; font-weight: 800; color: #6E4224; }
.stat-label { font-size: 22rpx; color: #8C5A2B; margin-top: 2rpx; }
.stat-divider { width: 1rpx; height: 52rpx; background: rgba(110,66,36,.18); }

.container { padding-top: 30rpx; }

/* 快捷操作九宫格 */
.quick-grid {
  display: flex; flex-wrap: wrap;
  background: #fff; border-radius: 30rpx; padding: 26rpx 10rpx;
  margin-bottom: 24rpx; box-shadow: 0 8rpx 26rpx rgba(180,110,40,.08);
}
.q-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 12rpx 0; }
.q-icon {
  width: 86rpx; height: 86rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-bottom: 12rpx;
  border: 1rpx solid rgba(255,180,120,.3);
}
.q-item text { font-size: 22rpx; color: #6E4224; font-weight: 600; }

/* 提醒卡 */
.warn-card {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FFF1DC, #FFE3C4);
  border: 1rpx solid #FFD9A8;
  border-radius: 26rpx; padding: 22rpx; margin-bottom: 24rpx;
}
.warn-icon { font-size: 44rpx; margin-right: 18rpx; }
.warn-body { flex: 1; min-width: 0; }
.warn-title { font-size: 28rpx; font-weight: 800; color: #B45A12; }
.warn-text { font-size: 23rpx; color: #8C5A2B; margin-top: 2rpx; }
.warn-btn {
  font-size: 24rpx; color: #fff; background: #F47521;
  padding: 10rpx 22rpx; border-radius: 30rpx; flex-shrink: 0;
}

/* 信息 */
.info-grid { display: flex; flex-wrap: wrap; }
.info-item { width: 50%; display: flex; align-items: center; margin: 12rpx 0; }
.info-label { font-size: 24rpx; color: #B08968; width: 100rpx; flex-shrink: 0; }
.info-value { font-size: 26rpx; color: #6E4224; font-weight: 600; }
.bio-row { display: flex; align-items: flex-start; margin: 10rpx 0; }
.bio-row .info-label { margin-top: 4rpx; }
.bio-text { flex: 1; font-size: 26rpx; color: #6E4224; line-height: 1.6; }

.member-row { display: flex; align-items: center; padding: 14rpx 0; }
.member-name { font-size: 27rpx; color: #6E4224; margin-left: 18rpx; font-weight: 600; }
.privacy-tip { font-size: 21rpx; color: #C9A381; margin-top: 10rpx; }

.lost-banner {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #FBE3D8, #F7CDBB);
  border-radius: 28rpx; padding: 26rpx; margin-bottom: 30rpx;
}
.lost-icon { font-size: 54rpx; margin-right: 20rpx; }
.lost-body { flex: 1; }
.lost-title { font-size: 30rpx; font-weight: 800; color: #8C3B1F; }
.lost-desc { font-size: 23rpx; color: #A65A38; }
.lost-arrow { font-size: 44rpx; color: #C97B3C; }
.bottom-tip { text-align: center; font-size: 22rpx; color: #C9A381; }
/* v1.1：好朋友 / 忌口 / 成长故事 / 弹层 */
.friend-row { display: flex; flex-wrap: wrap; gap: 18rpx; }
.friend-chip {
  display: flex; align-items: center;
  background: #FFF9F1; border: 1rpx solid #FFE8D0; border-radius: 40rpx;
  padding: 10rpx 24rpx 10rpx 12rpx;
}
.f-avatar {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; margin-right: 12rpx;
}
.f-name { font-size: 25rpx; color: #6E4224; font-weight: 700; }
.friend-empty {
  display: flex; align-items: center; justify-content: center;
  border: 2rpx dashed #FFD9B0; border-radius: 20rpx;
  padding: 26rpx; color: #C9A381; font-size: 23rpx;
}
.friend-empty text { margin-left: 12rpx; }

.note-card { padding: 8rpx 28rpx; }
.note-block { display: flex; align-items: flex-start; padding: 22rpx 0; border-bottom: 1rpx solid #FFF5EA; }
.note-block:last-child { border-bottom: none; }
.note-emoji { font-size: 40rpx; margin-right: 20rpx; line-height: 1.4; }
.note-title { font-size: 27rpx; font-weight: 800; color: #6E4224; }
.note-text { font-size: 25rpx; color: #8C5A2B; line-height: 1.7; margin-top: 2rpx; }

.story-card {
  background: linear-gradient(150deg, #FFF7EC, #FFEFDA);
  border: 1rpx solid #FFE0BC; border-radius: 30rpx;
  padding: 30rpx; margin-bottom: 24rpx;
  position: relative; overflow: hidden;
}
.story-head { display: flex; align-items: center; justify-content: space-between; }
.story-title { display: flex; align-items: center; font-size: 29rpx; font-weight: 800; color: #8C5A2B; }
.story-title paw { margin-right: 10rpx; }
.story-edit {
  font-size: 23rpx; color: #D96A1E; border: 1rpx solid #FFB36B;
  padding: 8rpx 22rpx; border-radius: 30rpx; background: #fff; flex-shrink: 0;
}
.story-text {
  margin-top: 20rpx; font-size: 27rpx; color: #6E4224;
  line-height: 1.9; text-align: justify;
}
.story-empty {
  margin-top: 20rpx; text-align: center;
  border: 2rpx dashed #FFC999; border-radius: 20rpx;
  padding: 34rpx; font-size: 25rpx; color: #C97B3C;
}
.story-sign { text-align: right; font-size: 22rpx; color: #C9A381; margin-top: 16rpx; }

.mask { position: fixed; inset: 0; z-index: 200; background: rgba(60,30,10,.45); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #FFFDF9; border-radius: 40rpx 40rpx 0 0; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { font-size: 33rpx; font-weight: 800; color: #52311B; text-align: center; margin-bottom: 14rpx; }
.fr-tip { text-align: center; font-size: 22rpx; color: #B08968; margin-bottom: 20rpx; }
.sheet-actions { display: flex; margin-top: 26rpx; }
.ph { color: #C9A381; }
/* 邀请面板样式 */
.inv-hint { text-align: center; font-size: 23rpx; color: #8C5A2B; margin-bottom: 22rpx; line-height: 1.6; }
.inv-link-box {
  display: flex; align-items: center;
  background: #FFF3E6; border: 1rpx solid #FFD9A8; border-radius: 20rpx;
  padding: 18rpx 20rpx;
}
.inv-link-text {
  flex: 1; font-size: 22rpx; color: #6E4224;
  word-break: break-all; line-height: 1.5; margin-right: 16rpx;
}
.inv-copy {
  flex-shrink: 0; background: linear-gradient(135deg, #FF9F4A, #F47521);
  color: #fff; font-size: 24rpx; font-weight: 700;
  padding: 12rpx 28rpx; border-radius: 32rpx;
}
.inv-actions { margin-top: 26rpx; }
.inv-tip { font-size: 21rpx; color: #B08968; text-align: center; margin-top: 20rpx; line-height: 1.6; }
/* 加入宠物家庭横幅 */
.join-bar {
  display: flex; align-items: center; margin: 20rpx 24rpx 0;
  background: linear-gradient(135deg, #FFE3DA, #FFC9B4);
  border: 1rpx solid #FFB79C; border-radius: 26rpx;
  padding: 22rpx 24rpx;
}
.jb-emoji { font-size: 52rpx; margin-right: 18rpx; }
.jb-title { font-size: 27rpx; font-weight: 800; color: #8C3B1F; }
.jb-sub { font-size: 22rpx; color: #A65A38; margin-top: 2rpx; }
.jb-go {
  background: #fff; color: #E4572E; font-size: 24rpx; font-weight: 800;
  padding: 12rpx 24rpx; border-radius: 32rpx; flex-shrink: 0;
}

/* pages/weight/weight.wxss */
.w-hero {
  display: flex; align-items: center;
  background: linear-gradient(150deg, #FFD9A0, #FF9F4A);
  padding: 44rpx 40rpx; border-radius: 0 0 48rpx 48rpx;
}
.w-stat { display: flex; align-items: baseline; margin-right: 34rpx; }
.w-num { font-size: 96rpx; font-weight: 800; color: #5E3716; line-height: 1; }
.w-unit { font-size: 30rpx; color: #7A4A1E; font-weight: 700; margin-left: 8rpx; }
.w-title { font-size: 30rpx; font-weight: 800; color: #5E3716; }
.w-date { font-size: 22rpx; color: #7A4A1E; margin-top: 4rpx; }
.trend {
  display: inline-block; margin-top: 12rpx;
  background: rgba(255,255,255,.75); border-radius: 24rpx;
  padding: 4rpx 18rpx; font-size: 22rpx; color: #6C8F46;
}
.trend.danger { background: #FFE3DA; color: #E4572E; }

.container { padding-top: 30rpx; }
.seg { display: flex; background: #FFF0DF; border-radius: 44rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 14rpx 0; font-size: 27rpx; color: #8C5A2B; border-radius: 40rpx; }
.seg-item.active {
  background: linear-gradient(135deg,#FF9F4A,#F47521); color: #fff; font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(244,117,33,.25);
}

.chart-card { padding: 24rpx 20rpx; }
.chart-title { font-size: 28rpx; font-weight: 800; color: #6E4224; padding: 6rpx 10rpx; }
.chart { width: 640rpx; height: 420rpx; margin: 8rpx auto 0; display: block; }
.chart-tip { text-align: center; font-size: 20rpx; color: #C9A381; }

.rec-card { padding: 12rpx 28rpx; }
.rec-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #FFF5EA; }
.rec-row:last-child { border-bottom: none; }
.rec-date {
  width: 84rpx; height: 84rpx; border-radius: 20rpx;
  background: linear-gradient(150deg, #FFE9D2, #FFD8B0);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin-right: 22rpx; flex-shrink: 0;
}
.rec-d { font-size: 34rpx; font-weight: 800; color: #B45A12; line-height: 1.1; }
.rec-m { font-size: 17rpx; color: #B08968; margin-top: 2rpx; }
.rec-weight { font-size: 36rpx; font-weight: 800; color: #6E4224; }
.rec-weight text { font-size: 22rpx; font-weight: 400; color: #B08968; }
.rec-diff { font-size: 24rpx; font-weight: 700; color: #6C8F46; }
.rec-diff.down { color: #E4572E; }

.mask { position: fixed; inset: 0; z-index: 200; background: rgba(60,30,10,.45); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #FFFDF9; border-radius: 40rpx 40rpx 0 0; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sheet-title { font-size: 34rpx; font-weight: 800; color: #52311B; text-align: center; margin-bottom: 26rpx; }
.picker-value { text-align: right; font-size: 27rpx; color: #6E4224; }
.ph { color: #C9A381; }
.sheet-actions { display: flex; margin-top: 26rpx; }


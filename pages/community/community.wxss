/* pages/community/community.wxss */
.comm-head {
  background: linear-gradient(150deg, #FFE3C4, #FFB36B);
  padding: 36rpx 34rpx 30rpx;
  border-radius: 0 0 44rpx 44rpx;
  position: relative;
}
.ch-title { font-size: 40rpx; font-weight: 800; color: #5E3716; }
.ch-sub { font-size: 24rpx; color: #7A4A1E; margin-top: 4rpx; }
.pet-filter {
  display: inline-block; margin-top: 20rpx;
  background: rgba(255,255,255,.85); color: #B45A12;
  border-radius: 30rpx; padding: 10rpx 26rpx; font-size: 24rpx; font-weight: 700;
}

.container { padding-top: 24rpx; }
.moment { padding: 26rpx; }
.m-head { display: flex; align-items: center; }
.m-author { margin-left: 18rpx; }
.m-name { font-size: 29rpx; font-weight: 800; color: #52311B; }
.m-pet { font-size: 22rpx; color: #B45A12; font-weight: 600; }
.m-time { font-size: 21rpx; color: #C9A381; margin-top: 2rpx; }
.m-follow {
  font-size: 22rpx; color: #F47521; border: 1rpx solid #FFB36B;
  padding: 6rpx 20rpx; border-radius: 26rpx;
}
.m-text { font-size: 28rpx; color: #6E4224; line-height: 1.7; margin: 20rpx 0; word-break: break-all; }
.m-imgs { display: flex; flex-wrap: wrap; gap: 10rpx; }
.m-img { width: 210rpx; height: 210rpx; border-radius: 16rpx; }
.m-img.single { width: 420rpx; height: 420rpx; }
.m-img-ph {
  height: 200rpx; border-radius: 20rpx;
  background: linear-gradient(135deg, #FFEFDE, #FFD9B8);
  display: flex; align-items: center; justify-content: center; flex-direction: column;
  margin-bottom: 6rpx;
}
.ph-emoji { font-size: 64rpx; }
.ph-text { font-size: 22rpx; color: #C97B3C; margin-top: 6rpx; }

.m-actions {
  display: flex; align-items: center;
  border-top: 1rpx solid #FFF0DF; margin-top: 20rpx; padding-top: 18rpx;
}
.act { flex: 1; text-align: center; font-size: 25rpx; color: #8C5A2B; }
.act.liked { color: #E4572E; font-weight: 700; }
/* 分享按钮使用原生 button open-type="share"，抹平默认边框与内边距 */
.act-share {
  background: transparent; border: none; padding: 0; margin: 0;
  line-height: inherit; height: auto; font-size: 25rpx; font-weight: 400; color: #8C5A2B;
}
.act-share::after { border: none; }

.m-comments {
  margin-top: 18rpx; background: #FFF9F1; border-radius: 18rpx;
  padding: 16rpx 20rpx;
}
.cmt { font-size: 25rpx; color: #6E4224; line-height: 1.8; }
.cmt-user { color: #B45A12; font-weight: 700; }

.fab { font-size: 40rpx; }

.mask { position: fixed; inset: 0; z-index: 200; background: rgba(60,30,10,.45); display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #FFFDF9; border-radius: 40rpx 40rpx 0 0; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; max-height: 85vh; overflow-y: auto; }
.sheet-title { font-size: 34rpx; font-weight: 800; color: #52311B; text-align: center; margin-bottom: 20rpx; }
.composer-pet { margin-bottom: 16rpx; }
.cpet {
  display: inline-block; background: #FFF1DC; color: #B45A12;
  border-radius: 26rpx; padding: 10rpx 24rpx; font-size: 24rpx;
}
.composer-text {
  width: 100%; box-sizing: border-box; min-height: 180rpx;
  background: #FFF6EC; border-radius: 20rpx; padding: 20rpx;
  font-size: 27rpx; color: #6E4224;
}
.ph { color: #C9A381; }
.img-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.img-cell { width: 160rpx; height: 160rpx; margin: 0 12rpx 12rpx 0; position: relative; }
.img-prev { width: 100%; height: 100%; border-radius: 16rpx; }
.img-del {
  position: absolute; top: -10rpx; right: -10rpx; width: 38rpx; height: 38rpx;
  border-radius: 50%; background: rgba(80,40,10,.75); color: #fff;
  font-size: 20rpx; display: flex; align-items: center; justify-content: center;
}
.img-add {
  width: 160rpx; height: 160rpx; border-radius: 16rpx;
  border: 2rpx dashed #FFC08A; color: #F47521; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
}
.sheet-actions { display: flex; margin-top: 20rpx; }
/* v1.1：爪印装饰 */
.comm-head { overflow: hidden; }
.comm-paw { position: absolute; right: 230rpx; bottom: -10rpx; }
